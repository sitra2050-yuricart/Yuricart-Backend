NODE_ENV=development
PORT=5000

# Local Compass: mongodb://127.0.0.1:27017/yuricart
# Atlas (Vercel): mongodb+srv://USER:PASS@CLUSTER.mongodb.net/yuricart?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/yuricart

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h

# Comma-separated storefront origins (local + Vercel/production)
FRONTEND_URL=http://localhost:3000

ADMIN_EMAIL=admin@yuricart.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=
BREVO_FROM_NAME=Yuricart
BREVO_FROM_EMAIL=noreply@yuricart.com
